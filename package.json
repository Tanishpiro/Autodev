{
  "name": "auto-dev",
  "version": "1.0.0",
  "description": "DeliveryFlow - CRM to Project Delivery Automation Engine",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "backend:seed": "npm --prefix backend run seed",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed",
    "db:up": "docker compose up -d mysql redis",
    "db:down": "docker compose down",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "crm",
    "automation",
    "deliveryflow"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "mysql2": "^3.24.5",
    "pg-mem": "^3.0.14"
  }
}
